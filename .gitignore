# --- Secrets ---
# Never commit real credentials. See .env.example for the documented template.
.env
.env.*
# ...but the documented, secret-free template MUST stay tracked.
!.env.example
# Pasted credential files placed at the repo root for local reference only.
# These hold real keys and must NEVER be committed or pushed. .env is the
# documented path (loaded via python-dotenv); the entries below defensively cover
# the ad-hoc *.txt shapes an operator might paste a key into. scripts/secret_guard.py
# is the DURABLE backstop — .gitignore only covers filenames we can name.
GEMINI_API_KEY
gemini_api.txt
gemini*.txt
*_api.txt
*.key
*.pem
secrets.txt

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# --- Node / frontend build ---
node_modules/
site/dist/
# Synthetic dev data generated by scripts/gen_dev_data.py — never committed.
site/public/data/

# --- OS / editor cruft ---
.DS_Store
*.log

# --- Human review queue ---
# Quarantined records awaiting human review (confidence < 0.8 or ambiguous
# dedup). Excluded from GitHub Pages and never auto-published.
data/_review/

# NOTE: data/ itself is intentionally NOT ignored. The daily GitHub Action
# regenerates and commits the data/ tree. Humans never hand-edit data/.

# Transient per-run manifest of open case-submission issues (§6), written by the
# scrape workflow before a discover run and read by the pipeline. Never committed.
submissions.json

# --- Operator scratch (unattended-run harness; never repo content) ---
NIGHT_RUN.md
NIGHT_QUEUE.md
NIGHT_LOG.md
MORNING_REPORT.md
night-watch.sh
night-watch.log
